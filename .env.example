# Higgsfield Console credentials. Used only by the Next.js server.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# How many generations Sky × Higgs will run at once.
HF_MAX_CONCURRENT=4

# Bearer token for ChatGPT Custom GPT Actions (/api/actions/*).
# Generate a long random string. Configure the same value in the GPT Action auth.
ACTIONS_API_KEY=
